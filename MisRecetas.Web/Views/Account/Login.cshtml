@model MisRecetas.Web.ViewModels.LoginViewModel
@{
    Layout = null; // Login no usa el layout con sidebar
    ViewData["Title"] = "Iniciar sesión";
}
<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] — MisRecetas</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
          rel="stylesheet"
          integrity="sha384-QWTKZyjpPEjISv5WaRU9OFeRpok6YctnYmDr5pNlyT2bRjXh0JMhjY6hW+ALEwIH"
          crossorigin="anonymous" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css"
          rel="stylesheet" />
    <style>
        body {
            background: linear-gradient(135deg, #1a2942 0%, #2d4a7a 100%);
            min-height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
        }
        .login-card {
            width: 100%;
            max-width: 400px;
            border-radius: 12px;
            box-shadow: 0 20px 60px rgba(0,0,0,.4);
            border: none;
        }
        .login-header {
            background: #1a2942;
            border-radius: 12px 12px 0 0;
            padding: 2rem;
            text-align: center;
            color: white;
        }
        .login-header .app-icon {
            width: 60px; height: 60px;
            background: rgba(255,255,255,.1);
            border-radius: 50%;
            display: flex; align-items: center; justify-content: center;
            margin: 0 auto 1rem;
            font-size: 1.8rem;
        }
        .login-header h4 { margin: 0; font-weight: 700; font-size: 1.25rem; }
        .login-header p { margin: .25rem 0 0; color: #7a9bbf; font-size: .85rem; }
        .login-body { padding: 2rem; }
        .form-floating label { color: #6c757d; }
        .btn-login {
            background: #1a2942;
            color: white;
            border: none;
            padding: .75rem;
            font-weight: 600;
            transition: background .2s;
        }
        .btn-login:hover { background: #2d4a7a; color: white; }
    </style>
</head>
<body>

<div class="login-card card">
    <div class="login-header">
        <div class="app-icon">
            <i class="bi bi-prescription2"></i>
        </div>
        <h4>MisRecetas</h4>
        <p>Sistema de gestión de recetas médicas</p>
    </div>
    <div class="login-body">

        @if (!ViewData.ModelState.IsValid)
        {
            <div class="alert alert-danger d-flex align-items-center gap-2 py-2" role="alert">
                <i class="bi bi-exclamation-triangle-fill"></i>
                <div asp-validation-summary="All" class="mb-0" style="font-size:.875rem;"></div>
            </div>
        }

        <form asp-action="Login" method="post">
            @Html.AntiForgeryToken()
            <input type="hidden" name="returnUrl" value="@ViewBag.ReturnUrl" />

            <div class="form-floating mb-3">
                <input asp-for="NombreUsuario"
                       class="form-control"
                       placeholder="Usuario"
                       autocomplete="username"
                       autofocus />
                <label asp-for="NombreUsuario">
                    <i class="bi bi-person me-1"></i>Usuario
                </label>
                <span asp-validation-for="NombreUsuario" class="text-danger small"></span>
            </div>

            <div class="form-floating mb-4">
                <input asp-for="Password"
                       class="form-control"
                       placeholder="Contraseña"
                       autocomplete="current-password" />
                <label asp-for="Password">
                    <i class="bi bi-lock me-1"></i>Contraseña
                </label>
                <span asp-validation-for="Password" class="text-danger small"></span>
            </div>

            <button type="submit" class="btn btn-login w-100 rounded-2">
                <i class="bi bi-box-arrow-in-right me-2"></i>Ingresar
            </button>
        </form>
    </div>
</div>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"
        integrity="sha384-YvpcrYf0tY3lHB60NNkmXc4s9bIOgUxi8T/jzmibHhPmn5n0snhBfQMiJUZoQbQpnFGn"
        crossorigin="anonymous"></script>
</body>
</html>
