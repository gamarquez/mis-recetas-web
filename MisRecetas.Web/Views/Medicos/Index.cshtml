@model List<MisRecetas.Web.Models.Medico>
@{
    ViewData["Title"] = "Medicos";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h4 class="mb-0"><i class="bi bi-person-badge me-2 text-primary"></i>Medicos</h4>
    <a asp-action="Crear" class="btn btn-primary btn-sm">
        <i class="bi bi-plus-circle me-1"></i>Nuevo medico
    </a>
</div>

@if (TempData["Success"] is string ok)
{
    <div class="alert alert-success alert-dismissible fade show py-2" role="alert">
        <i class="bi bi-check-circle me-1"></i>@ok
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

<div class="card shadow-sm">
    <div class="card-body p-0">
        <table class="table table-hover table-striped mb-0">
            <thead class="table-dark">
                <tr>
                    <th>#</th>
                    <th>Matricula</th>
                    <th>Apellido</th>
                    <th>Nombre</th>
                    <th class="text-end pe-3">Acciones</th>
                </tr>
            </thead>
            <tbody>
                @if (!Model.Any())
                {
                    <tr>
                        <td colspan="5" class="text-center text-muted py-4">
                            <i class="bi bi-inbox fs-4 d-block mb-1"></i>No hay medicos registrados.
                        </td>
                    </tr>
                }
                @foreach (var m in Model)
                {
                    <tr>
                        <td>@m.Id_Medico</td>
                        <td><strong>@m.Nro_Matricula</strong></td>
                        <td>@m.Apellido_Medico</td>
                        <td>@m.Nombre_Medico</td>
                        <td class="text-end pe-2">
                            <a asp-action="Editar" asp-route-id="@m.Id_Medico" class="btn btn-outline-secondary btn-sm">
                                <i class="bi bi-pencil me-1"></i>Editar
                            </a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
