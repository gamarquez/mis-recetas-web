@model MisRecetas.Web.ViewModels.MedicoViewModel
@{
    ViewData["Title"] = "Nuevo medico";
}

<div class="d-flex align-items-center mb-3">
    <a asp-action="Index" class="btn btn-outline-secondary btn-sm me-3">
        <i class="bi bi-arrow-left"></i>
    </a>
    <h4 class="mb-0"><i class="bi bi-person-badge me-2 text-primary"></i>Nuevo medico</h4>
</div>

<div class="row justify-content-center">
    <div class="col-md-6">
        <div class="card shadow-sm">
            <div class="card-body">
                <form asp-action="Crear" method="post">
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2 small"></div>

                    <div class="mb-3">
                        <label asp-for="Nro_Matricula" class="form-label fw-semibold">Nro. Matricula <span class="text-danger">*</span></label>
                        <input asp-for="Nro_Matricula" class="form-control" placeholder="Ej. 12345" />
                        <span asp-validation-for="Nro_Matricula" class="text-danger small"></span>
                    </div>
                    <div class="mb-3">
                        <label asp-for="Nombre_Medico" class="form-label fw-semibold">Nombre <span class="text-danger">*</span></label>
                        <input asp-for="Nombre_Medico" class="form-control" />
                        <span asp-validation-for="Nombre_Medico" class="text-danger small"></span>
                    </div>
                    <div class="mb-3">
                        <label asp-for="Apellido_Medico" class="form-label fw-semibold">Apellido <span class="text-danger">*</span></label>
                        <input asp-for="Apellido_Medico" class="form-control" />
                        <span asp-validation-for="Apellido_Medico" class="text-danger small"></span>
                    </div>

                    <div class="d-flex justify-content-end gap-2 mt-4">
                        <a asp-action="Index" class="btn btn-outline-secondary">Cancelar</a>
                        <button type="submit" class="btn btn-primary">
                            <i class="bi bi-save me-1"></i>Guardar
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{ await Html.RenderPartialAsync("_ValidationScriptsPartial"); }
}
