@model List<MisRecetas.Web.Models.Usuario>
@{ ViewData["Title"] = "Usuarios"; }
<div class="d-flex justify-content-between align-items-center mb-3">
    <h4 class="mb-0"><i class="bi bi-people-fill me-2 text-primary"></i>Usuarios</h4>
    <a asp-action="Crear" class="btn btn-primary btn-sm"><i class="bi bi-plus-circle me-1"></i>Nuevo usuario</a>
</div>
@if (TempData["Success"] is string ok) {
    <div class="alert alert-success alert-dismissible fade show py-2" role="alert">
        <i class="bi bi-check-circle me-1"></i>@ok
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}
<div class="card shadow-sm"><div class="card-body p-0">
    <table class="table table-hover table-striped mb-0">
        <thead class="table-dark"><tr>
            <th>Usuario</th><th>Nombre</th><th>Apellido</th><th>Rol</th>
            <th class="text-end pe-3">Acciones</th>
        </tr></thead>
        <tbody>
            @if (!Model.Any()) {
                <tr><td colspan="5" class="text-center text-muted py-4">No hay usuarios registrados.</td></tr>
            }
            @foreach (var u in Model) {
                <tr>
                    <td><strong>@u.Nombre_Usuario</strong></td><td>@u.Nombre</td>
                    <td>@u.Apellido</td>
                    <td><span class="badge bg-primary">@u.DescripcionRol</span></td>
                    <td class="text-end pe-2">
                        <a asp-action="Editar" asp-route-id="@u.Id_Usuario" class="btn btn-outline-secondary btn-sm me-1">
                            <i class="bi bi-pencil me-1"></i>Editar
                        </a>
                        <a asp-action="ResetPassword" asp-route-id="@u.Id_Usuario" class="btn btn-outline-danger btn-sm">
                            <i class="bi bi-key me-1"></i>Reset
                        </a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div></div>
