@model MisRecetas.Web.ViewModels.UsuarioViewModel
@{ ViewData["Title"] = "Editar usuario"; }
<div class="d-flex align-items-center mb-3">
    <a asp-action="Index" class="btn btn-outline-secondary btn-sm me-3"><i class="bi bi-arrow-left"></i></a>
    <h4 class="mb-0"><i class="bi bi-people-fill me-2 text-warning"></i>Editar usuario</h4>
</div>
<div class="row justify-content-center"><div class="col-md-6"><div class="card shadow-sm"><div class="card-body">
<form asp-action="Editar" method="post">
    <input asp-for="Id_Usuario" type="hidden" />
    <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2 small"></div>
    <div class="mb-3">
        <label asp-for="Nombre_Usuario" class="form-label fw-semibold">Nombre de usuario <span class="text-danger">*</span></label>
        <input asp-for="Nombre_Usuario" class="form-control" autocomplete="username" />
        <span asp-validation-for="Nombre_Usuario" class="text-danger small"></span>
    </div>
    <div class="row g-3 mb-3">
        <div class="col-md-6">
            <label asp-for="Nombre" class="form-label fw-semibold">Nombre <span class="text-danger">*</span></label>
            <input asp-for="Nombre" class="form-control" /><span asp-validation-for="Nombre" class="text-danger small"></span>
        </div>
        <div class="col-md-6">
            <label asp-for="Apellido" class="form-label fw-semibold">Apellido <span class="text-danger">*</span></label>
            <input asp-for="Apellido" class="form-control" /><span asp-validation-for="Apellido" class="text-danger small"></span>
        </div>
    </div>
    <div class="mb-3">
        <label asp-for="Id_Rol" class="form-label fw-semibold">Rol <span class="text-danger">*</span></label>
        <select asp-for="Id_Rol" asp-items="Model.ComboRoles" class="form-select">
            <option value="">-- Seleccionar --</option>
        </select>
        <span asp-validation-for="Id_Rol" class="text-danger small"></span>
    </div>
    <div class="alert alert-info py-2 small"><i class="bi bi-info-circle me-1"></i>Para cambiar la contrasena use la opcion <strong>Reset contrasena</strong>.</div>
    <div class="d-flex justify-content-end gap-2 mt-4">
        <a asp-action="Index" class="btn btn-outline-secondary">Cancelar</a>
        <button type="submit" class="btn btn-warning"><i class="bi bi-save me-1"></i>Guardar cambios</button>
    </div>
</form></div></div></div></div>
@section Scripts { @{ await Html.RenderPartialAsync("_ValidationScriptsPartial"); } }
