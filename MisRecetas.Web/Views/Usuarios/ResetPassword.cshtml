@model MisRecetas.Web.ViewModels.UsuarioViewModel
@{ ViewData["Title"] = "Resetear contrasena"; }
<div class="d-flex align-items-center mb-3">
    <a asp-action="Index" class="btn btn-outline-secondary btn-sm me-3"><i class="bi bi-arrow-left"></i></a>
    <h4 class="mb-0"><i class="bi bi-key me-2 text-danger"></i>Resetear contrasena</h4>
</div>
<div class="row justify-content-center"><div class="col-md-5">
    <div class="card shadow-sm border-danger">
        <div class="card-header bg-danger text-white">
            <i class="bi bi-exclamation-triangle me-2"></i>Resetear contrasena de: <strong>@Model.Nombre_Usuario</strong>
        </div>
        <div class="card-body">
            <form asp-action="ResetPassword" method="post">
                <input asp-for="Id_Usuario" type="hidden" />
                <input asp-for="Nombre_Usuario" type="hidden" />
                <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2 small"></div>
                <div class="mb-3">
                    <label asp-for="Password" class="form-label fw-semibold">Nueva contrasena <span class="text-danger">*</span></label>
                    <input asp-for="Password" type="password" class="form-control" autocomplete="new-password" />
                    <span asp-validation-for="Password" class="text-danger small"></span>
                </div>
                <div class="mb-3">
                    <label asp-for="ConfirmarPassword" class="form-label fw-semibold">Confirmar contrasena <span class="text-danger">*</span></label>
                    <input asp-for="ConfirmarPassword" type="password" class="form-control" autocomplete="new-password" />
                    <span asp-validation-for="ConfirmarPassword" class="text-danger small"></span>
                </div>
                <div class="d-flex justify-content-end gap-2 mt-4">
                    <a asp-action="Index" class="btn btn-outline-secondary">Cancelar</a>
                    <button type="submit" class="btn btn-danger"><i class="bi bi-key me-1"></i>Resetear contrasena</button>
                </div>
            </form>
        </div>
    </div>
</div></div>
@section Scripts { @{ await Html.RenderPartialAsync("_ValidationScriptsPartial"); } }
