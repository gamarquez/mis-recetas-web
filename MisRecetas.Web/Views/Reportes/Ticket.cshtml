@model MisRecetas.Web.ViewModels.ReporteViewModel
@{
    ViewData["Title"] = "Ticket de receta";

    // Use thermal layout only when we have a valid receipt to display
    bool tieneReceta = Model.NroReceta != null && Model.Datos.Any();
    Layout = tieneReceta ? "_ThermalLayout" : "_PopupLayout";
    if (tieneReceta) ViewData["NroReceta"] = Model.NroReceta;
}

@if (Model.NroReceta == null)
{
    // ── Vista de busqueda (sin numero de receta) ──────────────────────────
    <div class="card shadow-sm">
        <div class="card-body py-3">
            <p class="text-muted mb-3 small">Ingrese el numero de receta para ver e imprimir el ticket.</p>
            <form asp-action="Ticket" method="get" class="row g-2 align-items-end">
                <div class="col-8">
                    <label class="form-label small fw-semibold mb-1">Nro. Receta</label>
                    <input name="nro" class="form-control form-control-sm" placeholder="Ej: 1001" type="number" min="1" autofocus />
                </div>
                <div class="col-4">
                    <button type="submit" class="btn btn-primary btn-sm w-100">
                        <i class="bi bi-search me-1"></i>Buscar
                    </button>
                </div>
            </form>
        </div>
    </div>
}
else if (!Model.Datos.Any())
{
    // ── Receta no encontrada ──────────────────────────────────────────────
    <div class="alert alert-warning mt-3">
        <i class="bi bi-exclamation-triangle me-2"></i>No se encontro la receta Nro. @Model.NroReceta.
        <a asp-action="Ticket" class="btn btn-sm btn-outline-secondary ms-3">Volver</a>
    </div>
}
else
{
    var r = Model.Datos.First();

    // ════════ TICKET TERMICO ════════
    <div class="ticket">

        <div class="ticket-header">
            <div class="logo">Mis Recetas</div>
            <div class="subtitle">Farmacia Control de Recetas</div>
        </div>

        <div class="ticket-nro">
            <div class="label">Nro. Receta</div>
            <div class="nro">@r.Nro_Receta</div>
            <div><span class="estado-badge">@r.DescripcionEstado</span></div>
        </div>

        <hr class="ticket-sep" />

        <div class="ticket-row">
            <span class="lbl">Paciente:</span>
            <span class="val">@r.PacienteCompleto</span>
        </div>
        <div class="ticket-row">
            <span class="lbl">Doc.:</span>
            <span class="val">@r.TipoDocumento @r.NroDocumento</span>
        </div>

        <hr class="ticket-sep" />

        <div class="ticket-row">
            <span class="lbl">Medico:</span>
            <span class="val">@r.MedicoCompleto</span>
        </div>
        <div class="ticket-row">
            <span class="lbl">Matricula:</span>
            <span class="val">@r.NroMatricula</span>
        </div>

        <hr class="ticket-sep" />

        <div class="ticket-row">
            <span class="lbl">Registro:</span>
            <span class="val">@r.Fecha_Registro?.ToString("dd/MM/yyyy HH:mm")</span>
        </div>
        @if (r.Fecha_Entrega_Medico.HasValue)
        {
            <div class="ticket-row">
                <span class="lbl">Ent.Medico:</span>
                <span class="val">@r.Fecha_Entrega_Medico?.ToString("dd/MM/yyyy HH:mm")</span>
            </div>
        }
        @if (r.Fecha_Recibe_Medico.HasValue)
        {
            <div class="ticket-row">
                <span class="lbl">Rec.Medico:</span>
                <span class="val">@r.Fecha_Recibe_Medico?.ToString("dd/MM/yyyy HH:mm")</span>
            </div>
        }
        @if (r.Fecha_Entrega_Paciente.HasValue)
        {
            <div class="ticket-row">
                <span class="lbl">Ent.Paciente:</span>
                <span class="val">@r.Fecha_Entrega_Paciente?.ToString("dd/MM/yyyy HH:mm")</span>
            </div>
            <div class="ticket-row">
                <span class="lbl">Retira:</span>
                <span class="val">@r.Nombre_Retira (@r.Parentezco)</span>
            </div>
        }

        <div class="ticket-footer">
            Impreso: @DateTime.Now.ToString("dd/MM/yyyy HH:mm")
        </div>
    </div>
}
