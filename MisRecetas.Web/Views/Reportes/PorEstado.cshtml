@model MisRecetas.Web.ViewModels.ReporteViewModel
@{ ViewData["Title"] = "Recetas por estado"; }
<style>@@media print { .no-print { display: none !important; } }</style>
<div class="d-flex justify-content-between align-items-center mb-3 no-print">
    <div class="d-flex align-items-center">
        <a asp-action="Index" class="btn btn-outline-secondary btn-sm me-3"><i class="bi bi-arrow-left"></i></a>
        <h4 class="mb-0"><i class="bi bi-filter-square me-2 text-info"></i>Recetas por estado</h4>
    </div>
    @if (Model.Datos.Any()) { <button class="btn btn-primary btn-sm" onclick="window.print()"><i class="bi bi-printer me-1"></i>Imprimir / Exportar PDF</button> }
</div>
<div class="card shadow-sm mb-3 no-print"><div class="card-body py-2">
    <form asp-action="PorEstado" method="get" class="row g-2 align-items-end">
        <div class="col-md-4">
            <label class="form-label small mb-1">Estado</label>
            <select name="idEstado" class="form-select form-select-sm" asp-items="Model.ComboEstados">
                <option value="">-- Todos --</option>
            </select>
        </div>
        <div class="col-auto"><button type="submit" class="btn btn-primary btn-sm"><i class="bi bi-search me-1"></i>Filtrar</button></div>
    </form>
</div></div>
@if (Model.BusquedaRealizada)
{
    <div class="card shadow-sm">
        <div class="card-header d-flex justify-content-between">
            <span><strong>@Model.TituloReporte</strong> &mdash; <small class="text-muted">@Model.SubtituloReporte</small></span>
            <span class="badge bg-secondary">@Model.Datos.Count registros</span>
        </div>
        <div class="card-body p-0">
            <table class="table table-hover table-striped mb-0 small">
                <thead class="table-dark"><tr>
                    <th>Nro.</th><th>Paciente</th><th>Medico</th><th>Estado</th><th>Fecha registro</th><th>Ultima actualizacion</th>
                </tr></thead>
                <tbody>
                    @foreach (var r in Model.Datos) {
                        <tr>
                            <td><strong>@r.Nro_Receta</strong></td>
                            <td>@r.PacienteCompleto</td>
                            <td>@r.MedicoCompleto</td>
                            <td><span class="badge bg-secondary">@r.DescripcionEstado</span></td>
                            <td>@r.Fecha_Registro?.ToString("dd/MM/yyyy")</td>
                            <td>@((r.Fecha_Entrega_Paciente ?? r.Fecha_Recibe_Medico ?? r.Fecha_Entrega_Medico ?? r.Fecha_Registro)?.ToString("dd/MM/yyyy"))</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
}
