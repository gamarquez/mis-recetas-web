@model MisRecetas.Web.ViewModels.ReporteViewModel
@{ ViewData["Title"] = "Recetas por estado"; Layout = "_PopupLayout"; }

<div class="card shadow-sm mb-3">
    <div class="card-body py-2">
        <form asp-action="PorEstado" method="get" class="row g-2 align-items-end">
            <div class="col-md-5">
                <label class="form-label small mb-1">Estado</label>
                <select name="idEstado" class="form-select form-select-sm" asp-items="Model.ComboEstados">
                    <option value="">-- Todos --</option>
                </select>
            </div>
            <div class="col-auto">
                <button type="submit" class="btn btn-primary btn-sm"><i class="bi bi-search me-1"></i>Filtrar</button>
            </div>
        </form>
    </div>
</div>

@if (Model.BusquedaRealizada)
{
    <div class="card shadow-sm">
        <div class="card-header d-flex justify-content-between">
            <span>
                <strong>@Model.TituloReporte</strong>
                @if (!string.IsNullOrEmpty(Model.SubtituloReporte))
                {
                    <small class="text-muted ms-2">&mdash; @Model.SubtituloReporte</small>
                }
            </span>
            <span class="badge bg-secondary">@Model.Datos.Count registros</span>
        </div>
        <div class="card-body p-0">
            <table class="table table-hover table-striped mb-0 small">
                <thead class="table-dark">
                    <tr>
                        <th>Nro.</th><th>Paciente</th><th>Medico</th><th>Estado</th><th>Fecha registro</th><th>Ultima actualizacion</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var r in Model.Datos)
                    {
                        <tr>
                            <td><strong>@r.Nro_Receta</strong></td>
                            <td>@r.PacienteCompleto</td>
                            <td>@r.MedicoCompleto</td>
                            <td><span class="badge bg-secondary">@r.DescripcionEstado</span></td>
                            <td>@r.Fecha_Registro?.ToString("dd/MM/yyyy")</td>
                            <td>@((r.Fecha_Entrega_Paciente ?? r.Fecha_Recibe_Medico ?? r.Fecha_Entrega_Medico ?? r.Fecha_Registro)?.ToString("dd/MM/yyyy"))</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
}
