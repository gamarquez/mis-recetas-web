@model MisRecetas.Web.ViewModels.ReporteViewModel
@{ ViewData["Title"] = "Recibidas de medico"; Layout = "_PopupLayout"; }

<div class="card shadow-sm mb-3">
    <div class="card-body py-2">
        <form asp-action="RecibidasPorMedico" method="get" class="row g-2 align-items-end">
            <div class="col-md-6">
                <label class="form-label small mb-1">Medico</label>
                <select name="idMedico" class="form-select form-select-sm" asp-items="Model.ComboMedicos">
                    <option value="">-- Seleccionar --</option>
                </select>
            </div>
            <div class="col-auto">
                <button type="submit" class="btn btn-primary btn-sm"><i class="bi bi-search me-1"></i>Filtrar</button>
                <a asp-action="RecibidasPorMedico" class="btn btn-outline-secondary btn-sm ms-1">Limpiar</a>
            </div>
        </form>
    </div>
</div>

<div class="card shadow-sm">
    <div class="card-header d-flex justify-content-between">
        <span>
            <strong>@(string.IsNullOrEmpty(Model.TituloReporte) ? "Recetas recibidas del medico" : Model.TituloReporte)</strong>
            @if (!string.IsNullOrEmpty(Model.SubtituloReporte))
            {
                <small class="text-muted ms-2">&mdash; @Model.SubtituloReporte</small>
            }
        </span>
        <span class="badge bg-warning text-dark">@Model.Datos.Count registros</span>
    </div>
    <div class="card-body p-0">
        <table class="table table-hover table-striped mb-0 small">
            <thead class="table-dark">
                <tr>
                    <th>Nro.</th><th>Paciente</th><th>Medico</th><th>Matricula</th><th>Fecha recepcion del medico</th><th>Dias en estado 3</th>
                </tr>
            </thead>
            <tbody>
                @if (!Model.Datos.Any())
                {
                    <tr><td colspan="6" class="text-center text-muted py-3">No hay registros.</td></tr>
                }
                @foreach (var r in Model.Datos)
                {
                    <tr>
                        <td><strong>@r.Nro_Receta</strong></td>
                        <td>@r.PacienteCompleto</td>
                        <td>@r.MedicoCompleto</td>
                        <td>@r.NroMatricula</td>
                        <td>@r.Fecha_Recibe_Medico?.ToString("dd/MM/yyyy HH:mm")</td>
                        <td><span class="badge @(r.DiasEnEstado3 >= 7 ? "bg-danger" : "bg-secondary")">@r.DiasEnEstado3 d</span></td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
