@model MisRecetas.Web.ViewModels.ReporteViewModel
@{ ViewData["Title"] = "Recetas archivadas"; Layout = "_PopupLayout"; }

<div class="card shadow-sm mb-3">
    <div class="card-body py-2">
        <form asp-action="Archivadas" method="get" class="row g-2 align-items-end">
            <div class="col-md-3">
                <label class="form-label small mb-1">Desde</label>
                <input type="date" name="fechaDesde" value="@(Model.FechaDesde?.ToString("yyyy-MM-dd"))" class="form-control form-control-sm" />
            </div>
            <div class="col-md-3">
                <label class="form-label small mb-1">Hasta</label>
                <input type="date" name="fechaHasta" value="@(Model.FechaHasta?.ToString("yyyy-MM-dd"))" class="form-control form-control-sm" />
            </div>
            <div class="col-auto">
                <button type="submit" class="btn btn-primary btn-sm"><i class="bi bi-search me-1"></i>Filtrar</button>
                <a asp-action="Archivadas" class="btn btn-outline-secondary btn-sm ms-1">Limpiar</a>
            </div>
        </form>
    </div>
</div>

<div class="card shadow-sm">
    <div class="card-header d-flex justify-content-between">
        <span><strong>Recetas archivadas</strong></span>
        <span class="badge bg-secondary">@Model.Datos.Count registros</span>
    </div>
    <div class="card-body p-0">
        <table class="table table-hover table-striped mb-0 small">
            <thead class="table-dark">
                <tr>
                    <th>Nro.</th><th>Paciente</th><th>Medico</th><th>Fecha entrega paciente</th><th>Retira</th><th>Parentesco</th>
                </tr>
            </thead>
            <tbody>
                @if (!Model.Datos.Any())
                {
                    <tr><td colspan="6" class="text-center text-muted py-3">No hay registros.</td></tr>
                }
                @foreach (var r in Model.Datos)
                {
                    <tr>
                        <td><strong>@r.Nro_Receta</strong></td>
                        <td>@r.PacienteCompleto</td>
                        <td>@r.MedicoCompleto</td>
                        <td>@r.Fecha_Entrega_Paciente?.ToString("dd/MM/yyyy")</td>
                        <td>@r.Nombre_Retira</td>
                        <td>@r.Parentezco</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
