@model MisRecetas.Web.ViewModels.RegistrarRecetaViewModel
@{
    ViewData["Title"] = "Registrar receta";
    var nroRegistrada = TempData["NroRecetaRegistrada"] as int?;
}

@if (TempData["Success"] is string msgOk)
{
    <div class="alert alert-success alert-dismissible fade show d-flex align-items-center justify-content-between py-2 mb-3" role="alert">
        <span><i class="bi bi-check-circle me-2"></i>@msgOk</span>
        @if (nroRegistrada.HasValue)
        {
            <button type="button" class="btn btn-sm btn-outline-success ms-3"
                    onclick="abrirTicket(@nroRegistrada.Value)">
                <i class="bi bi-printer me-1"></i>Imprimir ticket Nro. @nroRegistrada.Value
            </button>
        }
        <button type="button" class="btn-close ms-2" data-bs-dismiss="alert"></button>
    </div>
}

<div class="d-flex align-items-center gap-3 mb-4">
    <div class="d-flex align-items-center gap-2">
        <div class="rounded-circle d-flex align-items-center justify-content-center fw-bold"
             style="width:32px;height:32px;background:@(Model.Paso >= 1 ? "#1a2942" : "#dee2e6");color:white;font-size:.85rem;">1</div>
        <span class="@(Model.Paso == 1 ? "fw-bold" : "text-muted") small">Buscar paciente</span>
    </div>
    <div class="flex-grow-1 border-top"></div>
    <div class="d-flex align-items-center gap-2">
        <div class="rounded-circle d-flex align-items-center justify-content-center fw-bold"
             style="width:32px;height:32px;background:@(Model.Paso >= 2 ? "#1a2942" : "#dee2e6");color:white;font-size:.85rem;">2</div>
        <span class="@(Model.Paso == 2 ? "fw-bold" : "text-muted") small">Datos y confirmar</span>
    </div>
</div>

@if (Model.Paso == 1)
{
    <div class="card border-0 shadow-sm">
        <div class="card-header bg-white border-bottom">
            <h6 class="mb-0 fw-semibold"><i class="bi bi-person-search me-2 text-primary"></i>Paso 1 - Buscar paciente</h6>
        </div>
        <div class="card-body p-4">
            <form asp-action="BuscarPaciente" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" asp-for="Paso" value="1" />
                @if (!ViewData.ModelState.IsValid)
                {
                    <div asp-validation-summary="All" class="alert alert-danger py-2 small"></div>
                }
                <div class="row g-3">
                    <div class="col-md-4">
                        <label asp-for="IdTipoDocumento" class="form-label fw-semibold"></label>
                        <select asp-for="IdTipoDocumento" asp-items="Model.ComboTipoDocumento" class="form-select">
                            <option value="0">- Tipo de documento -</option>
                        </select>
                    </div>
                    <div class="col-md-5">
                        <label asp-for="NroDocumento" class="form-label fw-semibold"></label>
                        <input asp-for="NroDocumento" class="form-control" placeholder="Ej: 30123456" autofocus />
                    </div>
                    <div class="col-md-3 d-flex align-items-end">
                        <button type="submit" class="btn btn-primary w-100">
                            <i class="bi bi-search me-1"></i>Buscar
                        </button>
                    </div>
                </div>
            </form>
        </div>
    </div>
}
else
{
    <form asp-action="ConfirmarRegistro" method="post">
        @Html.AntiForgeryToken()
        <input type="hidden" asp-for="Paso" value="2" />
        <input type="hidden" asp-for="IdTipoDocumento" />
        <input type="hidden" asp-for="NroDocumento" />
        <input type="hidden" asp-for="IdPacienteEncontrado" />
        <input type="hidden" asp-for="PacienteNuevo" />
        @if (!ViewData.ModelState.IsValid)
        {
            <div asp-validation-summary="All" class="alert alert-danger py-2 small mb-3"></div>
        }
        @if (!string.IsNullOrEmpty(Model.MensajeBusqueda))
        {
            <div class="alert @(Model.PacienteNuevo ? "alert-warning" : "alert-success") d-flex align-items-center gap-2 py-2 mb-3">
                <i class="bi @(Model.PacienteNuevo ? "bi-person-plus" : "bi-person-check")"></i>
                <span>@Model.MensajeBusqueda</span>
            </div>
        }
        <div class="row g-3">
            <div class="col-lg-7">
                <div class="card border-0 shadow-sm h-100">
                    <div class="card-header bg-white border-bottom">
                        <h6 class="mb-0 fw-semibold"><i class="bi bi-person me-2 text-primary"></i>@(Model.PacienteNuevo ? "Nuevo paciente" : "Datos del paciente")</h6>
                    </div>
                    <div class="card-body">
                        <div class="row g-3">
                            <div class="col-md-6">
                                <label asp-for="NombrePaciente" class="form-label fw-semibold small"></label>
                                <input asp-for="NombrePaciente" class="form-control" readonly="@(!Model.PacienteNuevo)" />
                                <span asp-validation-for="NombrePaciente" class="text-danger small"></span>
                            </div>
                            <div class="col-md-6">
                                <label asp-for="ApellidoPaciente" class="form-label fw-semibold small"></label>
                                <input asp-for="ApellidoPaciente" class="form-control" readonly="@(!Model.PacienteNuevo)" />
                                <span asp-validation-for="ApellidoPaciente" class="text-danger small"></span>
                            </div>
                            <div class="col-12">
                                <label asp-for="EmailPaciente" class="form-label fw-semibold small"></label>
                                <input asp-for="EmailPaciente" class="form-control" readonly="@(!Model.PacienteNuevo)" placeholder="email@ejemplo.com" />
                                <span asp-validation-for="EmailPaciente" class="text-danger small"></span>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            <div class="col-lg-5">
                <div class="card border-0 shadow-sm h-100">
                    <div class="card-header bg-white border-bottom">
                        <h6 class="mb-0 fw-semibold"><i class="bi bi-prescription2 me-2 text-primary"></i>Datos de la receta</h6>
                    </div>
                    <div class="card-body">
                        <div class="mb-3">
                            <label asp-for="IdMedico" class="form-label fw-semibold small"></label>
                            <select asp-for="IdMedico" asp-items="Model.ComboMedicos" class="form-select">
                                <option value="0">- Seleccione medico -</option>
                            </select>
                            <span asp-validation-for="IdMedico" class="text-danger small"></span>
                        </div>
                        <div class="mb-3">
                            <label asp-for="NroReceta" class="form-label fw-semibold small"></label>
                            <div class="input-group">
                                <span class="input-group-text bg-light"><i class="bi bi-hash"></i></span>
                                <input asp-for="NroReceta" class="form-control" />
                            </div>
                            <span asp-validation-for="NroReceta" class="text-danger small"></span>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <div class="d-flex gap-2 mt-3">
            <button type="submit" class="btn btn-success">
                <i class="bi bi-check-lg me-1"></i>Registrar receta
            </button>
            <a asp-action="Registrar" class="btn btn-outline-secondary">
                <i class="bi bi-arrow-left me-1"></i>Volver
            </a>
        </div>
    </form>
}

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        function abrirTicket(nro) {
            var url = '@Url.Action("Ticket", "Reportes")' + '?nro=' + nro;
            var ancho = 420, alto = 650;
            var left = Math.round((screen.width - ancho) / 2);
            var top  = Math.round((screen.height - alto)  / 2);
            window.open(url, 'ticket_' + nro,
                'width=' + ancho + ',height=' + alto +
                ',left=' + left + ',top=' + top +
                ',resizable=yes,scrollbars=yes,toolbar=no,menubar=no,location=no,status=no');
        }
    </script>
}