@model MisRecetas.Web.ViewModels.DashboardViewModel
@{
    ViewData["Title"] = "Panel de control";
}

<div class="mb-4">
    <h4 class="fw-bold mb-1">
        Bienvenido, @Model.NombreUsuario
    </h4>
    <p class="text-muted mb-0">
        <span class="badge bg-primary">@Model.Rol</span>
        &nbsp;Sistema de gestión de recetas médicas
    </p>
</div>

<!-- ── Tarjetas de estados ── -->
<div class="row g-3 mb-4">

    <div class="col-sm-6 col-xl-4">
        <a asp-controller="Recetas" asp-action="EntregarAMedico" class="text-decoration-none">
            <div class="card h-100 border-0 shadow-sm">
                <div class="card-body d-flex align-items-center gap-3">
                    <div class="rounded-circle d-flex align-items-center justify-content-center"
                         style="width:52px;height:52px;background:#e8f4fd;flex-shrink:0;">
                        <i class="bi bi-clock-history text-primary fs-4"></i>
                    </div>
                    <div>
                        <div class="fs-2 fw-bold lh-1 text-primary">@Model.TotalPendientes</div>
                        <div class="text-muted small">Pendientes en farmacia</div>
                    </div>
                </div>
            </div>
        </a>
    </div>

    <div class="col-sm-6 col-xl-4">
        <a asp-controller="Recetas" asp-action="RecibirDeMedico" class="text-decoration-none">
            <div class="card h-100 border-0 shadow-sm">
                <div class="card-body d-flex align-items-center gap-3">
                    <div class="rounded-circle d-flex align-items-center justify-content-center"
                         style="width:52px;height:52px;background:#fff3cd;flex-shrink:0;">
                        <i class="bi bi-person-badge text-warning fs-4"></i>
                    </div>
                    <div>
                        <div class="fs-2 fw-bold lh-1 text-warning">@Model.TotalConMedico</div>
                        <div class="text-muted small">Con el médico</div>
                    </div>
                </div>
            </div>
        </a>
    </div>

    <div class="col-sm-6 col-xl-4">
        <a asp-controller="Recetas" asp-action="EntregarAPaciente" class="text-decoration-none">
            <div class="card h-100 border-0 shadow-sm">
                <div class="card-body d-flex align-items-center gap-3">
                    <div class="rounded-circle d-flex align-items-center justify-content-center"
                         style="width:52px;height:52px;background:#d1e7dd;flex-shrink:0;">
                        <i class="bi bi-check2-circle text-success fs-4"></i>
                    </div>
                    <div>
                        <div class="fs-2 fw-bold lh-1 text-success">@Model.TotalListasParaEntregar</div>
                        <div class="text-muted small">Listas para entregar</div>
                    </div>
                </div>
            </div>
        </a>
    </div>

    @if (User.IsInRole("Administrador") || User.IsInRole("Administracion"))
    {
        <div class="col-sm-6 col-xl-4">
            <a asp-controller="Recetas" asp-action="Archivar" class="text-decoration-none">
                <div class="card h-100 border-0 shadow-sm @(Model.TotalParaArchivar > 0 ? "border-warning border-2" : "")">
                    <div class="card-body d-flex align-items-center gap-3">
                        <div class="rounded-circle d-flex align-items-center justify-content-center"
                             style="width:52px;height:52px;background:#fdecea;flex-shrink:0;">
                            <i class="bi bi-exclamation-triangle text-danger fs-4"></i>
                        </div>
                        <div>
                            <div class="fs-2 fw-bold lh-1 text-danger">@Model.TotalParaArchivar</div>
                            <div class="text-muted small">Pendientes de archivar</div>
                        </div>
                    </div>
                </div>
            </a>
        </div>

        <div class="col-sm-6 col-xl-4">
            <div class="card h-100 border-0 shadow-sm">
                <div class="card-body d-flex align-items-center gap-3">
                    <div class="rounded-circle d-flex align-items-center justify-content-center"
                         style="width:52px;height:52px;background:#e9ecef;flex-shrink:0;">
                        <i class="bi bi-archive text-secondary fs-4"></i>
                    </div>
                    <div>
                        <div class="fs-2 fw-bold lh-1 text-secondary">@Model.TotalArchivadas</div>
                        <div class="text-muted small">Archivadas</div>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-sm-6 col-xl-4">
            <div class="card h-100 border-0 shadow-sm">
                <div class="card-body d-flex align-items-center gap-3">
                    <div class="rounded-circle d-flex align-items-center justify-content-center"
                         style="width:52px;height:52px;background:#f8d7da;flex-shrink:0;">
                        <i class="bi bi-trash3 text-danger fs-4"></i>
                    </div>
                    <div>
                        <div class="fs-2 fw-bold lh-1 text-danger">@Model.TotalDesechadas</div>
                        <div class="text-muted small">Desechadas</div>
                    </div>
                </div>
            </div>
        </div>
    }

</div>

<!-- ── Accesos rápidos ── -->
<div class="card border-0 shadow-sm">
    <div class="card-header bg-white border-bottom">
        <h6 class="mb-0 fw-semibold">Accesos rápidos</h6>
    </div>
    <div class="card-body">
        <div class="d-flex flex-wrap gap-2">
            <a asp-controller="Recetas" asp-action="Registrar" class="btn btn-outline-primary">
                <i class="bi bi-plus-circle me-1"></i>Nueva receta
            </a>
            <a asp-controller="Recetas" asp-action="EntregarAMedico" class="btn btn-outline-secondary">
                <i class="bi bi-arrow-right-circle me-1"></i>Entregar a médico
            </a>
            <a asp-controller="Recetas" asp-action="RecibirDeMedico" class="btn btn-outline-secondary">
                <i class="bi bi-arrow-left-circle me-1"></i>Recibir de médico
            </a>
            <a asp-controller="Recetas" asp-action="EntregarAPaciente" class="btn btn-outline-success">
                <i class="bi bi-person-check me-1"></i>Entregar a paciente
            </a>
            <a asp-controller="Recetas" asp-action="Buscar" class="btn btn-outline-dark">
                <i class="bi bi-search me-1"></i>Buscar receta
            </a>
        </div>
    </div>
</div>
